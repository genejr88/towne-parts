generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  email     String?
  make      String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  ros       RO[]

  @@map("vendors")
}

model Technician {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("technicians")
}

model ProductionStage {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("production_stages")
}

model RO {
  id                      Int           @id @default(autoincrement())
  roNumber                String        @unique
  vehicleYear             String?
  vehicleMake             String?
  vehicleModel            String?
  vehicleColor            String?
  vin                     String?
  vendorId                Int?
  vendor                  Vendor?       @relation(fields: [vendorId], references: [id])
  partsStatus             PartsStatus   @default(MISSING)
  productionStage         String?       @default("unassigned")
  productionStatusNote    String?
  productionWaitingParts  String?
  productionNextStep      String?
  productionFinalSupplement Boolean     @default(false)
  productionSupplementNote String?
  productionUpdatedAt     DateTime?
  isBmw                   Boolean       @default(false)
  noPartsRequired         Boolean       @default(false)
  prestorageActive        Boolean       @default(false)
  prestorageLetterDate    DateTime?
  prestorageStartDate     DateTime?
  prestorageJobId         String?
  isHBM                   Boolean       @default(false)
  isTotalLoss             Boolean       @default(false)
  totalLossReleased       Boolean       @default(false)
  totalLossJobId          String?
  assignedTech            String?
  isArchived              Boolean       @default(false)
  archivedAt              DateTime?
  locationPhotoUrl        String?

  // Customer / Owner info
  ownerName               String?
  ownerPhone              String?
  ownerPhone2             String?
  ownerEmail              String?

  // Insurance info
  insuranceCompany        String?
  claimNumber             String?
  policyNumber            String?
  adjusterName            String?
  adjusterPhone           String?
  deductible              Decimal?      @db.Decimal(10, 2)
  dateOfLoss              DateTime?

  parts                   Part[]
  invoices                ROInvoice[]
  locationPhotos          ROLocationPhoto[]
  srcEntries              SRCEntry[]
  activityLog             ActivityLog[]
  supplements             Supplement[]
  statusUpdates           ProductionStatusUpdate[]
  tasks                   Task[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@map("ros")
}

model ProductionStatusUpdate {
  id            Int      @id @default(autoincrement())
  roId          Int
  ro            RO       @relation(fields: [roId], references: [id], onDelete: Cascade)
  statusNote    String?
  waitingParts  String?
  nextStep      String?
  stage         String?
  tech          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([roId, createdAt])
  @@map("production_status_updates")
}

model ROLocationPhoto {
  id               Int      @id @default(autoincrement())
  roId             Int
  ro               RO       @relation(fields: [roId], references: [id], onDelete: Cascade)
  storedPath       String
  caption          String?
  createdAt        DateTime @default(now())

  @@map("ro_location_photos")
}

enum PartsStatus {
  MISSING
  ACKNOWLEDGED
  ALL_HERE
}

model Part {
  id           Int          @id @default(autoincrement())
  roId         Int
  ro           RO           @relation(fields: [roId], references: [id], onDelete: Cascade)
  qty          Int          @default(1)
  partNumber   String?
  description  String?
  dateOrdered  DateTime?
  etaDate      DateTime?
  finishStatus FinishStatus @default(NO_FINISH_NEEDED)
  isReceived   Boolean      @default(false)
  hasCore      Boolean      @default(false)
  receivedAt   DateTime?
  price        Decimal?     @db.Decimal(10, 2)
  notes        String?
  photos       PartPhoto[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("parts")
}

enum FinishStatus {
  NEEDS_PAINT
  PAINTED
  TEXTURED
  NO_FINISH_NEEDED
}

model PartPhoto {
  id               Int      @id @default(autoincrement())
  partId           Int
  part             Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  originalFilename String?
  storedPath       String
  createdAt        DateTime @default(now())

  @@map("part_photos")
}

model ROInvoice {
  id               Int      @id @default(autoincrement())
  roId             Int
  ro               RO       @relation(fields: [roId], references: [id], onDelete: Cascade)
  originalFilename String?
  storedPath       String
  uploadedBy       String?
  fileType         String   @default("INVOICE")
  createdAt        DateTime @default(now())

  @@map("ro_invoices")
}

model SRCEntry {
  id              Int        @id @default(autoincrement())
  roId            Int?
  ro              RO?        @relation(fields: [roId], references: [id], onDelete: Cascade)
  entryType       SRCType
  status          SRCStatus  @default(OPEN)
  note            String?
  partNumber      String?
  partDescription String?
  vendorName      String?
  returnDate      DateTime?
  createdBy       String?
  completedAt     DateTime?
  photos          SRCPhoto[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("src_entries")
}

model SRCPhoto {
  id               Int      @id @default(autoincrement())
  srcEntryId       Int
  srcEntry         SRCEntry @relation(fields: [srcEntryId], references: [id], onDelete: Cascade)
  originalFilename String?
  storedPath       String
  createdAt        DateTime @default(now())

  @@map("src_photos")
}

enum SRCType {
  RETURN
  CORE_RETURN
}

enum SRCStatus {
  OPEN
  RETURNED
  CREDITED
  COMPLETED // retained for backward compat — no longer created by new code
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  roId      Int
  ro        RO       @relation(fields: [roId], references: [id], onDelete: Cascade)
  eventType String?
  message   String?
  createdAt DateTime @default(now())

  @@map("activity_log")
}

model PrivateFile {
  id               Int      @id @default(autoincrement())
  storedPath       String
  originalFilename String?
  caption          String?
  createdAt        DateTime @default(now())

  @@map("private_files")
}

model Supplement {
  id               Int                   @id @default(autoincrement())
  roId             Int
  ro               RO                    @relation(fields: [roId], references: [id], onDelete: Cascade)
  number           Int
  status           SupplementStatus      @default(REQUESTED)
  insuranceCompany String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  filingLogs       SupplementFilingLog[]

  @@unique([roId, number])
  @@map("supplements")
}

model CarrierProfile {
  id              Int                   @id @default(autoincrement())
  name            String                @unique
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactFax      String?
  portalUrl       String?
  preferredMethod String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  filingLogs      SupplementFilingLog[]

  @@map("carrier_profiles")
}

model SupplementFilingLog {
  id           Int             @id @default(autoincrement())
  supplement   Supplement      @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  supplementId Int
  carrier      CarrierProfile? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  carrierId    Int?
  method       String
  contactEmail String?
  contactFax   String?
  contactPhone String?
  portalUrl    String?
  notes        String?
  createdAt    DateTime        @default(now())

  @@map("supplement_filing_logs")
}

enum SupplementStatus {
  REQUESTED
  FILED
  COMPLETED
}

model BMWPayment {
  id         Int              @id @default(autoincrement())
  brand      String           @default("BMW") // "BMW" | "HYUNDAI_GENESIS" — same tracker, separate books
  month      Int
  year       Int
  date       DateTime?
  lastName   String?
  bmwNumber  String?
  roNumber   String?
  amount     Decimal?         @db.Decimal(10, 2)
  status     BMWPaymentStatus @default(NOT_RECEIVED)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([brand, year, month])
  @@map("bmw_payments")
}

enum BMWPaymentStatus {
  NOT_RECEIVED
  RECEIVED
}

model Task {
  id          Int       @id @default(autoincrement())
  roId        Int
  ro          RO        @relation(fields: [roId], references: [id], onDelete: Cascade)
  assignedTo  String
  note        String
  status      String    @default("PENDING")
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  completedBy String?

  @@index([status])
  @@index([assignedTo])
  @@index([roId])
  @@map("tasks")
}

model InventoryPart {
  id          String               @id @default(cuid())
  partNumber  String?
  description String
  qty         Int                  @default(1)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  photos      InventoryPartPhoto[]
}

model NumberSequence {
  id        Int      @id @default(autoincrement())
  program   String   @unique // "BMW" | "GENESIS_FAIRFIELD" | "GENESIS_MILFORD" (add rows here to add programs)
  prefix    String   // "M" | "GF" | "GM"
  current   Int      @default(0) // last number issued — next generate = current + 1
  padLength Int      @default(0) // 0 = no padding (M1130), 4 = zero-padded (GF0002)
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}

model AssignedNumber {
  id              Int      @id @default(autoincrement())
  program         String   // "BMW" | "GENESIS_FAIRFIELD" | "GENESIS_MILFORD"
  number          String   // e.g. "M1130", "GF0002" — freely editable after generation
  programRoNumber String?  // the manufacturer/dealer-side RO (e.g. BMW RO)
  towneRoNumber   String?  // Towne's internal RO
  vehicleYear     String?
  vehicleMake     String?
  vehicleModel    String?
  customerName    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([program])
  @@map("assigned_numbers")
}

model HitchKit {
  id          Int          @id @default(autoincrement())
  shopifyId   String       @unique // Stealth Hitches product id
  handle      String?
  title       String       // vehicle fitment string, e.g. "2007-2011 BMW 3 Series Sedan Gas"
  sku         String?
  price       Decimal      @db.Decimal(10, 2)
  available   Boolean      @default(true)
  rackOnly    Boolean      @default(false) // auto-detected from title ("Rack Only"); editable override
  syncedAt    DateTime     @default(now())
  quotes      HitchQuote[]

  @@index([title])
  @@map("hitch_kits")
}

enum HitchTier {
  RACK_ONLY
  RACK_AND_TOW
  RACK_TOW_WIRING
}

model HitchQuote {
  id            Int       @id @default(autoincrement())
  hitchKitId    Int?
  hitchKit      HitchKit? @relation(fields: [hitchKitId], references: [id], onDelete: SetNull)
  vehicleTitle  String    // snapshot of the matched kit's title at quote time
  kitHandle     String?   // snapshot of the Stealth product handle — builds the live product-page link
  kitPrice      Decimal   @db.Decimal(10, 2) // snapshot — survives future Stealth price changes
  tier          HitchTier
  tierFee       Decimal   @db.Decimal(10, 2) // snapshot of the flat fee at quote time
  shipping      Decimal   @db.Decimal(10, 2) @default(40.00)
  taxRate       Decimal   @db.Decimal(5, 4)  @default(0.0635)
  subtotal      Decimal   @db.Decimal(10, 2)
  tax           Decimal   @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  customerName  String?
  customerPhone String?
  customerEmail String?
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@map("hitch_quotes")
}

model InventoryPartPhoto {
  id                String        @id @default(cuid())
  inventoryPartId   String
  inventoryPart     InventoryPart @relation(fields: [inventoryPartId], references: [id], onDelete: Cascade)
  originalFilename  String
  storedPath        String
  createdAt         DateTime      @default(now())
}
